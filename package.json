{
  "name": "assignment-3-meridian-build",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Meridian Clinic on Cloudflare Zero Trust: three Node surfaces behind a tunnel, each gating itself on a verified Access token.",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "forge": "tsx scripts/forge.ts",
    "rehearse": "tsx scripts/rehearsal.ts",
    "lint": "oxlint -c .oxlintrc.json src scripts test",
    "typecheck": "tsc -p tsconfig.json && tsc -p pages/tsconfig.json",
    "test": "vitest run",
    "pages:deploy": "./scripts/render-wrangler.sh && cd pages && ../node_modules/.bin/wrangler pages deploy",
    "pages:dev": "./scripts/render-wrangler.sh && cd pages && ../node_modules/.bin/wrangler pages dev",
    "pages:secrets": "./scripts/set-pages-secrets.sh",
    "env:sync": "./scripts/sync-env-from-terraform.sh"
  },
  "dependencies": {
    "express": "4.22.2",
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@types/express": "4.17.25",
    "@types/node": "24.13.3",
    "oxlint": "1.79.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "3.2.7",
    "wrangler": "4.126.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
