# Copy to .env and fill in. .env is gitignored; nothing here is a secret (GR2).

# Zero Trust team domain, without the scheme. Must match the team name chosen during
# Zero Trust onboarding: the origin verifies every token's `iss` against exactly this.
CF_TEAM_DOMAIN=

# Account id — dashboard right-hand sidebar, or the hex string in the dashboard URL.
CF_ACCOUNT_ID=

# The scoped API token (R38). Account-level, eight permissions, no zone scopes; the exact
# list is in the README. A Global API Key here is an automatic failure.
CF_API_TOKEN=

# Created by Terraform; the Pages Function reads its counters and origin URLs from it.
CF_KV_NAMESPACE_ID=

# R19 — the AUD tag of each Access application, from the application's Overview tab.
# These must differ. Reusing one tag across both applications is the R22 vulnerability.
ACCESS_AUD_ADMIN=
ACCESS_AUD_PARTNER=

# R13 — the six named staff. Access decides at the edge; the origin checks again.
STAFF_EMAILS=

# R25 — the partner lab's service token client id (the CF-Access-Client-Id value).
PARTNER_CLIENT_IDS=

# Free-path only: shared with the Pages Function, which HMACs the hop to the quick tunnel.
# openssl rand -hex 32
EDGE_HMAC_SECRET=

# Refuse requests that did not come through the Pages Function. Leave unset (true) on the
# free path; the origin is on a public trycloudflare URL and the edge is bypassable without it.
REQUIRE_EDGE_SIGNATURE=true

# R32 — the partner lab's webhook signing key. openssl rand -hex 32
LAB_WEBHOOK_SECRET=

# R31 — Turnstile secret key, verified server-side on every booking.
TURNSTILE_SECRET=

BIND_HOST=127.0.0.1
PORT_PUBLIC=3000
PORT_ADMIN=3001
PORT_PARTNER=3002
