# R8 and R10 — the connector as a managed service, and as more than one of them.
#
# The distinction this file exists to make: `cloudflared tunnel run` in a terminal is not a
# deployment. It dies with the terminal, it dies with the SSH session, and — the case that
# actually bites — it dies on reboot at 4am and nobody notices until the clinic opens.
#
# A TEMPLATE unit (note the @). Instantiated as cloudflared-private@1 and @2, which is R10:
# two connectors serving one named tunnel. Both read the same credentials and the same ingress
# table, register independently with the Cloudflare edge, and appear as two connectors on the
# tunnel — traffic survives either one being stopped, upgraded or killed. This is the exercise
# a quick tunnel cannot do at all: a quick tunnel has no credentials file and no stable name,
# so a second process is a second tunnel, not a second connector.
#
# Installed by scripts/root-setup.sh to /etc/systemd/system/cloudflared-private@.service.

[Unit]
Description=Meridian private-network connector %i (named tunnel, WARP routing)
After=network-online.target
Wants=network-online.target
# Not Requires=: if the network comes up late, Restart=always retries anyway, and a hard
# dependency here means a transient DHCP failure leaves the operator locked out of the box.

# [Unit], not [Service]. systemd moved the start rate limiter here, and a modern systemd
# silently ignores it in [Service] with only `Unknown key name ... ignoring` in the journal —
# so the unit looks configured, logs a warning nobody reads, and keeps the default limit.
# Without this, five fast failures inside 10s put the unit in `failed` and systemd stops
# trying: the connector would stay down through exactly the flapping-network condition that
# Restart=always was chosen for.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify

# R9 — the token arrives as an environment variable from a 0600 file owned by root. Never an
# ExecStart argument: an argument is visible in `ps` to every user on the box for the life of
# the process, and lands in shell history the first time someone runs it by hand. cloudflared
# reads TUNNEL_TOKEN natively, so there is no reason to ever type it.
EnvironmentFile=/etc/cloudflared/private.env

# --metrics per instance, because two processes cannot bind one port and the failure is
# obscure: the second connector exits at startup complaining about an address in use, which
# reads as a tunnel problem rather than an observability one. %i is the instance number, so
# @1 gets 20241 and @2 gets 20242.
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml --metrics 127.0.0.1:2024%i tunnel run

Restart=always
RestartSec=5s
# The rate limiter that would otherwise defeat Restart=always is turned off in [Unit] above,
# because that is the section systemd reads it from. See the note there.

User=cloudflared
Group=cloudflared

# The connector needs outbound network and nothing else on this box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
